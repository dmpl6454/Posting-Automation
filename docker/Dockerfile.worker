FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
# Runtime: chromium for puppeteer + native libs for the `canvas` npm package
# (cairo / pango / jpeg / giflib / pixman / librsvg). Build tools (python3,
# build-base, pkgconfig, *-dev) are required during `pnpm install` because
# `canvas@2.x` compiles native bindings via node-gyp. Fix Module 9 / QA #N9.
# Fonts note (super-text, 2026-07-27): `font-noto-emoji` gives Chromium a COLOUR
# emoji face — without it the user's 😍✨ burn as tofu boxes. `ttf-liberation`
# is metric-compatible with Arial (what the browser preview uses on macOS/Windows),
# so the strip wraps at the same words in the preview and in the burn. Do not drop
# either: the compose preview and the burned video would silently diverge.
RUN apk add --no-cache \
    ffmpeg chromium nss freetype harfbuzz ca-certificates ttf-freefont \
    ttf-liberation font-noto font-noto-emoji \
    cairo pango jpeg giflib pixman librsvg \
    build-base python3 pkgconfig \
    cairo-dev pango-dev jpeg-dev giflib-dev pixman-dev librsvg-dev
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY patches/ patches/
COPY packages/db/package.json packages/db/
COPY packages/social/package.json packages/social/
COPY packages/queue/package.json packages/queue/
COPY packages/ai/package.json packages/ai/
COPY packages/logger/package.json packages/logger/
# super-text: shared strip schema + HTML builder (the burn worker renders the
# strip from the SAME builder the compose preview uses). apps/worker declares it
# as a workspace dep, so it MUST be copied here or the install below fails.
COPY packages/super-text/package.json packages/super-text/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile

# Build
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/queue/node_modules ./packages/queue/node_modules
COPY --from=deps /app/packages/social/node_modules ./packages/social/node_modules
COPY --from=deps /app/packages/ai/node_modules ./packages/ai/node_modules
COPY --from=deps /app/packages/logger/node_modules ./packages/logger/node_modules
# ⚠️ EVERY workspace package with runtime deps needs its node_modules copied here
# explicitly — the builder does NOT inherit them from `COPY packages/`. Omitting
# this line shipped a worker that crash-looped on `Cannot find module 'zod'` from
# packages/super-text/src/schema.ts (prod incident 2026-07-28). It passed local
# image testing only because .dockerignore is EMPTY, so `COPY packages/` pulled in
# the developer's own node_modules and masked the gap — a clean checkout (which is
# what the server has) has none. Verify new packages with a `git archive` build.
COPY --from=deps /app/packages/super-text/node_modules ./packages/super-text/node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

# Generate Prisma client
RUN pnpm --filter @postautomation/db db:generate

# Production
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NODE_OPTIONS="--dns-result-order=ipv4first"

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/ ./packages/
COPY --from=builder /app/apps/worker/ ./apps/worker/
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/package.json ./

CMD ["pnpm", "--filter", "@postautomation/worker", "start"]
