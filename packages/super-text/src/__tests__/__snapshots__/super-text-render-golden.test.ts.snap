exports[`golden render gate — insta layout preset (opt-in) > burn frame for the instagram face declares its @font-face at weight 500 1`] = `"<!DOCTYPE html><html><head><meta charset="utf-8"><style>@font-face{font-family:'Instagram Sans';font-style:normal;font-weight:500;font-display:block;src:url(data:font/woff2;base64,<payload>) format('woff2');}html,body{margin:0;padding:0;background:transparent;width:1080px;height:1920px;overflow:hidden}.anchor{position:absolute;left:50%;top:84%;transform:translate(-50%,-50%);width:max-content;max-width:calc(86% - 0.68em);text-align:left;font-size:52px}</style></head><body><div class="anchor"><span style="background:#FFFFFF;color:#111111;font-weight:500;font-family:'Instagram Sans', Arial, 'Liberation Sans', 'Helvetica Neue', Helvetica, sans-serif, 'Apple Color Emoji', 'Noto Color Emoji', 'Segoe UI Emoji';line-height:1.5;padding:0.1em 0.68em;border-radius:0.24em;-webkit-box-decoration-break:clone;box-decoration-break:clone;white-space:pre-wrap;"><span style="color:#D8501B">Anil</span> <span style="color:#D8501B">Kapoor</span> <span style="color:#111111">exits</span> <span style="color:#111111">from</span> <span style="color:#111111">Juhu</span> <span style="color:#111111">PVR</span></span></div></body></html>"`;

